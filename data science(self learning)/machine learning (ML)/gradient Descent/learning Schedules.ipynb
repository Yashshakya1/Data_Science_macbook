    "                   └────────────┬───────────┘\n",
    "                                │\n",
    "                                ▼\n",
    "                   ┌────────────────────────┐\n",
    "                   │ Set Initial Learning LR │\n",
    "                   └────────────┬───────────┘\n",
    "                                │\n",
    "                                ▼\n",
    "                 ┌──────────────────────────────┐\n",
    "                 │ Choose Learning Rate Schedule │\n",
    "                 └───────┬─────────┬────────────┘\n",
    "                         │         │\n",
    "     ┌───────────────────┼─────────┼──────────────────┐\n",
