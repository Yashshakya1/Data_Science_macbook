    "┌──────────────┐ ┌──────────────┐ ┌──────────────┐ ┌────────────────┐\n",
    "│ After N      │ │ Compute LR =  │ │ LR = LR0 /   │ │ Slowly increase │\n",
    "│ epochs       │ │ LR0 * e^(-kt) │ │ (1 + k*t)    │ │ LR for warm-up  │\n",
    "└─────┬────────┘ └─────┬─────────┘ └─────┬────────┘ └──────┬─────────┘\n",
